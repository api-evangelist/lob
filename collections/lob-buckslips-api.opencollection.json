                "description": "How many results to return."
              },
              {
                "name": "before/after",
                "value": "",
                "type": "query",
                "description": "`before` and `after` are both optional but only one of them can be in the query at a time.\n"
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Request that the response include the total count by specifying `include=[\"total_count\"]`.\n"
              }
            ]
          },
          "docs": "Returns a list of your buckslips. The buckslips are returned sorted by creation date, with the most recently created buckslips appearing first."
        },
        {
          "info": {
            "name": "Create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.lob.com/v1/buckslips",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new buckslip given information"
        }
      ]
    }
  ],
  "bundled": true
